CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // 0-16383 is RAM. 16384-24575 is screen memory.
    Not(in=address[14], out=selectRAM);
    Not(in=address[13], out=lowerHalf);
    And(a=address[14], b=lowerHalf, out=selectScreen);
    And(a=load, b=selectRAM, out=loadRAM);
    And(a=load, b=selectScreen, out=loadScreen);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramData);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenData);
    Keyboard(out=keyData);

    // Only address 24576 in the top region selects the keyboard.
    Or8Way(in=address[0..7], out=lowBits);
    Or8Way(in[0..4]=address[8..12], in[5..7]=false, out=highBits);
    Or(a=lowBits, b=highBits, out=nonZeroOffset);
    Mux16(a=keyData, b=false, sel=nonZeroOffset, out=topData);
    Mux16(a=screenData, b=topData, sel=address[13], out=ioData);
    Mux16(a=ramData, b=ioData, sel=address[14], out=out);
}
